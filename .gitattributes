# 统一换行：仓库内一律 LF，避免 Windows 上 CRLF 污染 diff 与"同种子两次运行逐字节一致"的校验
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.xlsx binary
*.xls binary
*.pdf binary
*.jar binary
*.mv.db binary

# 生成/导出的文本文件照旧按文本处理
*.csv text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.java text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.vue text eol=lf
